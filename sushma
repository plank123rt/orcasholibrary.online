<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prescription Ledger Protocol: Orcasho</title>
<link rel="icon" type="image/png" href="/favicon.png?v=2"> 
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#132520;
    --ink-2:#1c3a32;
    --paper:#ede6d6;
    --paper-2:#e2d9c4;
    --graphite:#5c6660;
    --amber:#c0872e;
    --amber-dim:#a97a2c;
    --positive:#3f8f6d;
    --negative:#b54b32;
    --neutral:#8b8578;
    --line:rgba(19,37,32,0.16);
    --radius:2px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans',sans-serif;
    line-height:1.55;
    overflow-x:hidden;
  }
  ::selection{background:var(--amber);color:var(--paper);}
  h1,h2,h3{
    font-family:'Fraunces',serif;
    font-weight:600;
    margin:0;
    letter-spacing:-0.01em;
  }
  .mono{font-family:'IBM Plex Mono',monospace;}
  .eyebrow{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--amber-dim);
    display:flex;
    align-items:center;
    gap:0.6em;
    margin-bottom:0.9em;
  }
  .eyebrow::before{content:"";width:22px;height:1px;background:var(--amber-dim);display:inline-block;}

  @media (prefers-reduced-motion:no-preference){
    .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease, transform .7s ease;}
    .reveal.in{opacity:1;transform:translateY(0);}
  }

  /* ---------- Hero / requisition header ---------- */
  .hero{
    background:
      radial-gradient(ellipse at 15% 0%, var(--ink-2) 0%, var(--ink) 55%);
    color:var(--paper);
    padding:4.5rem 1.6rem 3.6rem;
    position:relative;
    overflow:hidden;
  }
  .hero::after{
    content:"";
    position:absolute;inset:0;
    background-image:repeating-linear-gradient(0deg, rgba(237,230,214,0.035) 0 1px, transparent 1px 26px);
    pointer-events:none;
  }
  .hero-inner{max-width:900px;margin:0 auto;position:relative;}
  .hero .eyebrow{color:var(--amber);}
  .hero h1{
    font-size:clamp(2.1rem, 5vw, 3.3rem);
    color:var(--paper);
    max-width:14ch;
  }
  .hero p.lede{
    max-width:56ch;
    margin-top:1.1rem;
    font-size:1.05rem;
    color:rgba(237,230,214,0.82);
  }
  .req-meta{
    margin-top:2.4rem;
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(160px,1fr));
    border-top:1px solid rgba(237,230,214,0.22);
    border-left:1px solid rgba(237,230,214,0.22);
  }
  .req-meta div{
    padding:0.9rem 1rem;
    border-right:1px solid rgba(237,230,214,0.22);
    border-bottom:1px solid rgba(237,230,214,0.22);
  }
  .req-meta .k{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.65rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:rgba(237,230,214,0.55);
    display:block;
    margin-bottom:0.3rem;
  }
  .req-meta .v{font-size:0.95rem;}

  /* ---------- Stamp ---------- */
  .stamp{
    display:inline-flex;
    align-items:center;
    gap:0.5em;
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--negative);
    border:2px solid var(--negative);
    border-radius:999px;
    padding:0.35em 0.9em;
    transform:rotate(-3deg);
    opacity:0.92;
  }
  @media (prefers-reduced-motion:no-preference){
    .stamp.animate{animation:stampHit .5s cubic-bezier(.2,1.6,.4,1) both;}
  }
  @keyframes stampHit{
    0%{transform:rotate(-3deg) scale(1.9);opacity:0;}
    70%{opacity:1;}
    100%{transform:rotate(-3deg) scale(1);opacity:0.92;}
  }

  /* ---------- Layout: tab rail + main ---------- */
  .layout{
    max-width:1180px;
    margin:0 auto;
    display:grid;
    grid-template-columns:180px 1fr;
    gap:0;
  }
  @media (max-width:840px){
    .layout{grid-template-columns:1fr;}
  }
  nav.rail{
    position:sticky;
    top:0;
    align-self:start;
    padding:2.4rem 0.8rem 2rem 1.6rem;
  }
  @media (max-width:840px){
    nav.rail{
      position:static;
      display:flex;
      gap:0.6rem;
      padding:1.2rem 1.6rem;
      overflow-x:auto;
    }
  }
  nav.rail a{
    display:block;
    font-family:'IBM Plex Mono',monospace;
    font-size:0.74rem;
    letter-spacing:0.04em;
    text-decoration:none;
    color:var(--graphite);
    background:var(--paper-2);
    border:1px solid var(--line);
    border-right:none;
    padding:0.7rem 0.8rem;
    margin-bottom:-1px;
    position:relative;
    transition:color .2s ease, background .2s ease;
    white-space:nowrap;
  }
  @media (max-width:840px){
    nav.rail a{border:1px solid var(--line);margin-bottom:0;border-radius:3px;}
  }
  nav.rail a:hover, nav.rail a.active{
    color:var(--ink);
    background:var(--paper);
  }
  nav.rail a b{display:block;color:var(--amber-dim);font-weight:600;}

  main{padding:2.4rem 1.6rem 4rem;min-width:0;}
  section{margin-bottom:4rem;}
  section h2{font-size:clamp(1.5rem,3vw,2rem);max-width:22ch;}
  section > p.intro{max-width:64ch;margin-top:0.9rem;color:#33463f;}

  .card{
    background:var(--paper);
    border:1px solid var(--line);
    border-top:3px solid var(--ink);
    padding:1.6rem 1.7rem;
    margin-top:1.6rem;
    position:relative;
  }
  .card::before{
    content:"";
    position:absolute;
    top:-3px;left:1.4rem;
    width:34px;height:3px;
    background:var(--amber);
  }
  .card h3{font-size:1.05rem;margin-bottom:0.7rem;}
  .card ul, .card ol{padding-left:1.2rem;margin:0.6rem 0 0;}
  .card li{margin-bottom:0.55rem;}
  .card li:last-child{margin-bottom:0;}

  /* ---------- Schema table ---------- */
  .table-wrap{overflow-x:auto;margin-top:1.6rem;border:1px solid var(--line);}
  table.schema{border-collapse:collapse;width:100%;min-width:720px;background:var(--paper);}
  table.schema th, table.schema td{
    text-align:left;
    padding:0.65rem 0.8rem;
    border-bottom:1px solid var(--line);
    font-size:0.9rem;
    vertical-align:top;
  }
  table.schema thead th{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.68rem;
    letter-spacing:0.08em;
    text-transform:uppercase;
    background:var(--ink);
    color:var(--paper);
  }
  table.schema td.col{font-family:'IBM Plex Mono',monospace;font-weight:600;color:var(--amber-dim);white-space:nowrap;}
  table.schema tbody tr:nth-child(odd){background:var(--paper-2);}
  table.schema td.blank{color:var(--graphite);font-style:italic;}

  /* ---------- Tracker ---------- */
  .tracker-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:1.4rem;
    margin-top:1.6rem;
  }
  @media (max-width:700px){.tracker-grid{grid-template-columns:1fr;}}
  @media (max-width:480px){
    button.primary{width:100%;}
    .req-meta{grid-template-columns:1fr 1fr;}
  }
  .field{display:flex;flex-direction:column;gap:0.4rem;margin-bottom:1rem;}
  .field label{font-family:'IBM Plex Mono',monospace;font-size:0.68rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--graphite);}
  .field input{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.95rem;
    padding:0.55rem 0.6rem;
    border:1px solid var(--line);
    background:var(--paper-2);
    color:var(--ink);
    border-radius:2px;
  }
  .field input:focus, button:focus-visible, a:focus-visible{
    outline:2px solid var(--amber);
    outline-offset:2px;
  }
  button.primary{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.78rem;
    letter-spacing:0.06em;
    text-transform:uppercase;
    background:var(--ink);
    color:var(--paper);
    border:none;
    padding:0.7rem 1.1rem;
    cursor:pointer;
    border-radius:2px;
    transition:background .2s ease;
  }
  button.primary:hover{background:var(--ink-2);}
  button.primary:disabled{opacity:0.5;cursor:wait;}

  .counter-block{
    background:var(--paper-2);
    border:1px solid var(--line);
    padding:1.4rem 1.6rem;
    text-align:left;
  }
  .counter-block .big{
    font-family:'Fraunces',serif;
    font-size:2.6rem;
    line-height:1;
    color:var(--ink);
  }
  .counter-block .of{font-family:'IBM Plex Mono',monospace;font-size:0.8rem;color:var(--graphite);margin-top:0.4rem;}
  .bar{height:6px;background:var(--line);border-radius:99px;margin-top:0.9rem;overflow:hidden;}
  .bar div{height:100%;background:var(--amber);width:0%;transition:width .5s ease;}

  .strip-wrap{margin-top:1.8rem;overflow-x:auto;padding-bottom:0.5rem;}
  #dayStrip{display:flex;gap:6px;min-width:max-content;}
  .day-cell{
    width:46px;
    flex:0 0 auto;
    text-align:center;
    font-family:'IBM Plex Mono',monospace;
    padding:0.4rem 0.2rem;
    border:1px solid var(--line);
    background:var(--paper);
    border-radius:2px;
  }
  .day-cell .dow{font-size:0.58rem;color:var(--graphite);text-transform:uppercase;}
  .day-cell .dnum{font-size:0.85rem;margin:0.15rem 0;}
  .day-cell .cnt{font-size:0.7rem;color:var(--amber-dim);font-weight:600;}
  .day-cell.range{background:rgba(192,135,46,0.1);}
  .day-cell.has-data{border-color:var(--positive);}
  .day-cell.today{outline:2px solid var(--ink);}

  .sync-note{
    margin-top:1rem;
    font-size:0.78rem;
    color:var(--graphite);
    display:flex;align-items:center;gap:0.5em;
  }
  .dot{width:7px;height:7px;border-radius:50%;background:var(--neutral);display:inline-block;}
  .dot.live{background:var(--positive);}

  code.inline{
    font-family:'IBM Plex Mono',monospace;
    background:var(--paper-2);
    padding:0.1em 0.4em;
    border-radius:2px;
    font-size:0.88em;
  }

  footer{
    background:var(--ink);
    color:rgba(237,230,214,0.7);
    padding:2.4rem 1.6rem;
    text-align:center;
    font-size:0.85rem;
  }
  footer .stamp{margin-bottom:1rem;}

  ::-webkit-scrollbar{height:8px;width:8px;}
  ::-webkit-scrollbar-thumb{background:var(--graphite);border-radius:4px;}
</style>
</head>
<body>

<div class="hero">
  <div class="hero-inner">
    <div class="eyebrow">Orcasho · Operations requisition</div>
    <h1>Prescription Ledger Protocol</h1>
    <p class="lede">Turn the supplement prescription PDFs into a clean, structured ledger, one row per prescription. Everything here stays on your machine.</p>
    <div class="req-meta">
      <div><span class="k">Assigned to</span><span class="v">Intern</span></div>
      <div><span class="k">Prepared by</span><span class="v">Vikrant · Orcasho</span></div>
      <div><span class="k">Source files</span><span class="v mono">Individual prescription PDFs (~2,000 files)</span></div>
      <div><span class="k">Handling</span><span class="v"><span class="stamp animate">Local only · no cloud</span></span></div>
    </div>
  </div>
</div>

<div class="layout">
  <nav class="rail">
    <a href="#task01"><b>01</b>PDFs → Ledger</a>
    <a href="#tracker"><b>02</b>Progress tracker</a>
  </nav>

  <main>

    <!-- TASK 1 -->
    <section id="task01" class="reveal">
      <div class="eyebrow">Task 01 · do this first</div>
      <h2>Turn the prescription PDFs into a ledger</h2>
      <p class="intro">You'll be working through a folder of around 2,000 individual prescription PDFs. Your job is to open each one and log it as one row in a local Excel file. Nothing gets summarized or reworded. You're transcribing, not interpreting.</p>

      <div class="card">
        <h3>Ground rules before you open anything</h3>
        <ul>
          <li>Work in <b>Excel or LibreOffice Calc, saved to a local folder</b> on this machine (or the drive Vikrant points you to). No Google Sheets, no Office 365 cloud autosave, no syncing the file anywhere.</li>
          <li>The prescription PDFs and the ledger you build from them never get uploaded, emailed, or pasted into any website, chatbot, or AI tool (including for "just checking a format" or "just this one row").</li>
          <li>Treat every source PDF as read-only. You're extracting from it, never editing, renaming, or merging the files.</li>
        </ul>
      </div>

      <div class="card">
        <h3>Reading a prescription PDF</h3>
        <p>You'll see at least two layout variants in the folder; both carry the same information, just arranged differently. Look for these fields on every one:</p>
        <ul>
          <li><b>Patient's Name</b>: usually near the top, sometimes in a highlighted band, sometimes plain text next to "Patient's Name."</li>
          <li><b>Set Start Date</b>: always present. The date this particular supplement set begins.</li>
          <li><b>Prescription Date</b>: present on some PDFs, not on others. If it's missing, leave that cell blank and note "not printed" in the Notes column. Don't guess or copy the Set Start Date into it.</li>
          <li><b>Prescription body</b>: the paragraph describing the supplement set, dosage, and timing (e.g. "Digestive Enzymes + Probiotics + GrapeSeed, 1 pill each, once after lunch"). Copy this exactly as written, including odd spacing or capitalization.</li>
          <li><b>Prescribing doctor</b>: named at the top of the page and again above the signature. This is normally Dt. Navya Bharti, but double-check each PDF rather than assuming.</li>
          <li><b>PrescriSign #</b>: a verification number near the signature or seal. Where possible, this should match the number embedded in the source filename. If it doesn't match, flag it in Notes rather than picking one.</li>
        </ul>
      </div>

      <div class="card">
        <h3>The ledger (exact columns, in this order)</h3>
        <p>One sheet, one header row (frozen), one prescription per row. Order rows by filename or by Set Start Date, whichever you pick, and stay consistent. Never re-sort the sheet itself; use a filter view if you need to search.</p>
        <div class="table-wrap">
          <table class="schema">
            <thead>
              <tr><th>Col</th><th>Field</th><th>What goes in the cell</th></tr>
            </thead>
            <tbody>
              <tr><td class="col">A</td><td>S.No</td><td>Running row number, 1 upward across the whole sheet. Never reused, never skipped.</td></tr>
              <tr><td class="col">B</td><td>Patient Name</td><td>Exactly as printed on the PDF. If spelling varies across a patient's prescriptions, keep what's written and note the variant in column I.</td></tr>
              <tr><td class="col">C</td><td>Source File Name</td><td>The exact PDF filename, unedited. This is your link back to the original document.</td></tr>
              <tr><td class="col">D</td><td>PrescriSign #</td><td>The verification number printed near the signature or seal.</td></tr>
              <tr><td class="col">E</td><td>Set Start Date</td><td>Standardized to DD-MM-YYYY.</td></tr>
              <tr><td class="col">F</td><td>Prescription Date</td><td>Standardized to DD-MM-YYYY. Leave blank if not printed on that PDF.</td></tr>
              <tr><td class="col">G</td><td>Prescribing Doctor</td><td>The doctor named on that specific PDF.</td></tr>
              <tr><td class="col">H</td><td>Raw Prescription Text</td><td>The full instruction paragraph, copied exactly as written, in one cell with wrap text turned on. Don't clean up spelling or reword anything.</td></tr>
              <tr><td class="col">I</td><td>Notes / Flags</td><td>Anything uncertain: unclear name, missing date, a mismatched PrescriSign #, a guess you made.</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <h3>Row rules &amp; a sane workflow</h3>
        <ol>
          <li>One PDF = one row, no matter how long the instruction paragraph runs.</li>
          <li>Go through the folder in batches (a few hundred files at a time is manageable) and update the progress tracker below after each batch, so Vikrant can see steady movement rather than one big update at the end.</li>
          <li>With close to 2,000 files in the folder, treat that as a loose target for the total row count, not an exact number to hit.</li>
        </ol>
      </div>
    </section>

    <!-- TRACKER -->
    <section id="tracker" class="reveal">
      <div class="eyebrow">Progress tracker</div>
      <h2>Log where you are, every day</h2>
      <p class="intro">Set the target window once. After that, just enter how many new rows you added each day. It's saved straight to Firebase, so Vikrant can watch progress without you sending anything by hand. Only dates and counts ever go into this tracker, never feedback content.</p>

      <div class="card">
        <h3>Target window</h3>
        <div class="tracker-grid">
          <div class="field">
            <label for="startDate">Start date</label>
            <input type="date" id="startDate">
          </div>
          <div class="field">
            <label for="endDate">End date</label>
            <input type="date" id="endDate">
          </div>
        </div>
        <button class="primary" id="saveWindow">Save window</button>
      </div>

      <div class="card">
        <h3>Today's count</h3>
        <div class="tracker-grid">
          <div>
            <div class="field">
              <label for="entryDate">Date</label>
              <input type="date" id="entryDate">
            </div>
            <div class="field">
              <label for="entryCount">Rows logged that day</label>
              <input type="number" id="entryCount" min="0" step="1" placeholder="0">
            </div>
            <button class="primary" id="saveEntry">Log today's count</button>
            <p class="sync-note"><span class="dot" id="liveDot"></span><span id="syncStatus">Not connected. Add your Firebase config in the code</span></p>
          </div>
          <div class="counter-block">
            <div class="of">Cumulative rows logged</div>
            <div class="big" id="cumTotal">0</div>
            <div class="of"><span id="targetLabel">of ~2,000 estimated</span></div>
            <div class="bar"><div id="cumBar"></div></div>
          </div>
        </div>
        <div class="strip-wrap">
          <div id="dayStrip"></div>
        </div>
      </div>
    </section>

  </main>
</div>

<footer>
  <div class="stamp">Local only · no cloud</div>
  <p>Orcasho · Prescription Ledger Protocol · handle patient data accordingly.</p>
</footer>

<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
<script>
/* ============================================================
   FIREBASE SETUP
   Config below points at the timeline-intern Firebase project,
   writing to its own "intern_progress_rx" collection so this
   tracker doesn't mix with the feedback-ledger tracker's data.
   Only dates + counts are ever written here, never prescription
   content.
   ============================================================ */
const firebaseConfig = {
  apiKey: "AIzaSyCvzOgH9k_F0kl-HzN5GrVl-iypswmS1Rw",
  authDomain: "timeline-intern.firebaseapp.com",
  projectId: "timeline-intern",
  storageBucket: "timeline-intern.firebasestorage.app",
  messagingSenderId: "154821899397",
  appId: "1:154821899397:web:fe105ca6273d30f70325ec"
};

let db = null;
let firebaseReady = false;
try {
  if (firebaseConfig.apiKey && firebaseConfig.apiKey !== "PASTE_YOUR_API_KEY") {
    firebase.initializeApp(firebaseConfig);
    db = firebase.firestore();
    firebaseReady = true;
    document.getElementById('syncStatus').textContent = 'Connected to Firebase';
    document.getElementById('liveDot').classList.add('live');
  }
} catch (e) {
  console.error("Firebase init failed:", e);
}

const COLLECTION = "intern_progress_rx";
const SETTINGS_DOC = "_settings";

const startInput = document.getElementById('startDate');
const endInput = document.getElementById('endDate');
const entryDate = document.getElementById('entryDate');
const entryCount = document.getElementById('entryCount');
const cumTotalEl = document.getElementById('cumTotal');
const cumBar = document.getElementById('cumBar');
const targetLabel = document.getElementById('targetLabel');
const dayStrip = document.getElementById('dayStrip');

const TARGET_ESTIMATE = 2000;
let dailyData = {}; // date string -> count

const today = new Date().toISOString().slice(0,10);
entryDate.value = today;

function fmtDate(d){ return d.toISOString().slice(0,10); }

function renderStrip(){
  dayStrip.innerHTML = "";
  const start = startInput.value ? new Date(startInput.value) : new Date();
  const end = endInput.value ? new Date(endInput.value) : new Date(start.getTime() + 13*86400000);
  const dowNames = ['S','M','T','W','T','F','S'];
  let cursor = new Date(start);
  let safety = 0;
  while (cursor <= end && safety < 400) {
    const ds = fmtDate(cursor);
    const cell = document.createElement('div');
    cell.className = 'day-cell range';
    if (ds === today) cell.classList.add('today');
    const count = dailyData[ds];
    if (count) cell.classList.add('has-data');
    cell.innerHTML = `<div class="dow">${dowNames[cursor.getDay()]}</div><div class="dnum">${cursor.getDate()}</div><div class="cnt">${count ? count : '-'}</div>`;
    dayStrip.appendChild(cell);
    cursor.setDate(cursor.getDate()+1);
    safety++;
  }
}

function renderTotals(){
  const total = Object.values(dailyData).reduce((a,b)=>a+b, 0);
  cumTotalEl.textContent = total;
  const pct = Math.min(100, Math.round((total / TARGET_ESTIMATE) * 100));
  cumBar.style.width = pct + '%';
  targetLabel.textContent = `of ~${TARGET_ESTIMATE.toLocaleString()} estimated (${pct}%)`;
}

async function loadSettings(){
  if (!firebaseReady) { renderStrip(); return; }
  try {
    const doc = await db.collection(COLLECTION).doc(SETTINGS_DOC).get();
    if (doc.exists) {
      const d = doc.data();
      if (d.startDate) startInput.value = d.startDate;
      if (d.endDate) endInput.value = d.endDate;
    }
  } catch(e){ console.error(e); }
  renderStrip();
}

async function saveWindow(){
  if (!startInput.value || !endInput.value) { alert("Pick both a start and end date first."); return; }
  if (firebaseReady) {
    try {
      await db.collection(COLLECTION).doc(SETTINGS_DOC).set({
        startDate: startInput.value,
        endDate: endInput.value
      }, { merge: true });
    } catch(e){ console.error(e); alert("Could not save to Firebase. Check the console."); }
  }
  renderStrip();
}

async function saveEntry(){
  const d = entryDate.value;
  const c = parseInt(entryCount.value, 10);
  if (!d || isNaN(c) || c < 0) { alert("Enter a valid date and count."); return; }
  const btn = document.getElementById('saveEntry');
  btn.disabled = true;
  dailyData[d] = c;
  if (firebaseReady) {
    try {
      await db.collection(COLLECTION).doc(d).set({ date: d, count: c, loggedAt: new Date().toISOString() });
    } catch(e){ console.error(e); alert("Could not save to Firebase. Check the console."); }
  }
  renderStrip();
  renderTotals();
  btn.disabled = false;
}

function subscribeLive(){
  if (!firebaseReady) return;
  db.collection(COLLECTION).onSnapshot(snap => {
    snap.forEach(doc => {
      if (doc.id === SETTINGS_DOC) return;
      const d = doc.data();
      if (d && d.date) dailyData[d.date] = d.count || 0;
    });
    renderStrip();
    renderTotals();
  }, err => console.error(err));
}

document.getElementById('saveWindow').addEventListener('click', saveWindow);
document.getElementById('saveEntry').addEventListener('click', saveEntry);
startInput.addEventListener('change', renderStrip);
endInput.addEventListener('change', renderStrip);

loadSettings();
subscribeLive();
renderTotals();

/* ---------- scroll reveal ---------- */
if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
} else {
  document.querySelectorAll('.reveal').forEach(el=>el.classList.add('in'));
}

/* ---------- active tab highlight ---------- */
const sections = document.querySelectorAll('main section[id]');
const navLinks = document.querySelectorAll('nav.rail a');
const navIO = new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{
    const link = document.querySelector(`nav.rail a[href="#${entry.target.id}"]`);
    if (!link) return;
    if (entry.isIntersecting) {
      navLinks.forEach(l=>l.classList.remove('active'));
      link.classList.add('active');
    }
  });
}, { rootMargin: "-20% 0px -70% 0px" });
sections.forEach(s=>navIO.observe(s));
</script>
</body>
